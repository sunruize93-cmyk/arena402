# Keep browser requests same-origin. Next.js proxies /api to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=

# Used by Next.js/Vercel when the browser calls the same-origin /api path.
# Cloud is the default integration target. Override with
# http://127.0.0.1:8000 only when intentionally testing a local backend.
API_PROXY_TARGET=https://api.arena402.com
