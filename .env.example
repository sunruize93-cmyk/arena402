# Leave blank for local same-origin development. In Vercel production, set this
# to https://api.arena402.com so browser API calls bypass the Vercel rewrite.
NEXT_PUBLIC_API_URL=

# Used only when NEXT_PUBLIC_API_URL is blank and the browser calls same-origin
# /api paths. Override with http://127.0.0.1:8000 for explicit local proxy tests.
API_PROXY_TARGET=https://api.arena402.com

# Block explorer for /ledger verify links. Defaults to the Injective EVM
# testnet Blockscout; point it at the mainnet explorer when the chain switches.
NEXT_PUBLIC_EXPLORER_URL=https://testnet.blockscout.injective.network
